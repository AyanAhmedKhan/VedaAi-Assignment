NEXT_PUBLIC_API_BASE=http://localhost:4000

# --- Persistent backend (recommended on Vercel) ---
# Without these, the in-memory store is used. On Vercel, the in-memory store
# doesn't survive serverless cold starts → assignments can 404 between polls.
# Create a free Redis at https://upstash.com and paste the REST creds:
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# --- AI ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_DAILY_LIMIT=5
